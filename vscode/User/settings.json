{
    "[html]": {
        "editor.defaultFoldingRangeProvider": "esbenp.prettier-vscode",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.bracketSameLine": true,
        "prettier.singleAttributePerLine": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua",
        "editor.formatOnSave": true
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "black-formatter.args": ["--line-length=120"],
    "black-formatter.showNotifications": "onWarning",
    "chat.agent.enabled": false,
    "chat.checkpoints.enabled": false,
    "chat.checkpoints.showFileChanges": false,
    "chat.disableAIFeatures": true,
    "chat.editor.fontSize": 15,
    "chat.editor.wordWrap": "on",
    "chat.fontSize": 15,
    "cSpell.customDictionaries": {
        "custom-dictionary": {
            "addWords": true,
            "name": "custom-dictionary",
            "path": "~/AppData/Roaming/Code/User/cspell-custom-dictionary.txt",
            "scope": "workspace"
        },
        "custom": true
    },
    "cSpell.ignorePaths": [
        "node_modules",
        "**/node_modules",
        "**/node_modules/**",
        "vscode-extension",
        ".git",
        "*.dll",
        "**/*.dll"
    ],
    "cSpell.ignoreWords": [],
    "cSpell.languageSettings": [
        {
            "dictionaries": ["wordsEn"],
            "languageId": "*",
            "locale": "en"
        },
        {
            "dictionaries": ["wordsEn"],
            "languageId": "*",
            "locale": "en-US"
        },
        {
            "dictionaries": ["wordsEnGb"],
            "languageId": "*",
            "locale": "en-GB"
        },
        {
            "dictionaries": ["companies", "softwareTerms", "misc"],
            "languageId": "*"
        },
        {
            "dictionaries": ["python"],
            "languageId": "python"
        },
        {
            "dictionaries": ["go"],
            "languageId": "go"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "javascript"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "javascriptreact"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "typescript"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "typescriptreact"
        },
        {
            "dictionaries": ["html", "fonts", "typescript", "css"],
            "languageId": "html"
        },
        {
            "dictionaries": ["php", "html", "fonts", "css", "typescript"],
            "languageId": "php"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "css"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "less"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "scss"
        }
    ],
    "debug.breakpointsView.presentation": "tree",
    "debug.console.fontFamily": "'SpaceMono Nerd Font', 'MesloLGM Nerd Font Mono'",
    "debug.console.fontSize": 15,
    "editor.allowVariableFonts": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "always"
    },
    "editor.codeLensFontSize": 14,
    "editor.colorDecoratorsLimit": 2000,
    "editor.defaultFoldingRangeProvider": "esbenp.prettier-vscode",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.definitionLinkOpensInPeek": true,
    "editor.detectIndentation": false,
    "editor.fontFamily": "'Google Sans Code', 'Space Mono', 'Source Code Pro', monospace",
    "editor.fontLigatures": false,
    "editor.fontSize": 15,
    "editor.indentSize": "tabSize",
    "editor.inlayHints.fontSize": 14,
    "editor.language.brackets": [],
    "editor.smoothScrolling": false,
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 120,
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "eslint.bulkSuppression.enable": true,
    "eslint.ignoreUntitled": true,
    "eslint.onIgnoredFiles": "warn",
    "eslint.probe": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "html",
        "mdx",
        "markdown",
        "json",
        "jsonc",
        "css",
        "graphql"
    ],
    "eslint.trace.server": "off",
    "eslint.useESLintClass": true,
    "eslint.useFlatConfig": true,
    "eslint.validate": ["javascript", "typescript", "javascriptreact", "typescriptreact", "json"],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        ".editorconfig": "eslint.*.ts, stylelint.*.ts, prettier.*.ts",
        "*.db": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.js": "${capture}.d.ts, ${capture}.js.*, ${capture}.css, ${capture}.css.*, ${capture}.min.js",
        "*.jsx": "${capture}.js",
        "*.s3db": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.sqlite": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.ts": "${capture}.d.ts, ${capture}.js, ${capture}*.scss, ${capture}*.css",
        "*.tsx": "${capture}.ts, ${capture}.js, ${capture}*.scss, ${capture}*.css",
        "package.json": "package-lock.json, yarn.lock, .yarnrc.yml, pnpm-lock.yaml, bun.lockb, bun.lock",
        "tsconfig.json": "tsconfig*json, *.d.ts"
    },
    "explorer.incrementalNaming": "smart",
    "explorer.openEditors.minVisible": 20,
    "explorer.openEditors.visible": 20,
    "explorer.sortOrder": "foldersNestsFiles",
    "explorer.sortOrderLexicographicOptions": "unicode",
    "files.autoSave": "onWindowChange",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "git.addAICoAuthor": "off",
    "git.autoStash": true,
    "git.detectWorktrees": true,
    "git.inputValidation": true,
    "git.showActionButton": {
        "sync": false
    },
    "git.showCommitInput": false,
    "git.showPushSuccessNotification": true,
    "git.terminalGitEditor": true,
    "git.verboseCommit": true,
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.wrapLineLength": 120,
    "html.suggest.hideEndTagSuggestions": true,
    "inlineChat.askInChat": false,
    "ipynb.experimental.serialization": false,
    "ipynb.pasteImagesAsAttachments.enabled": false,
    "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json": true,
        "https://www.schemastore.org/": true
    },
    "json.schemas": [
        {
            "fileMatch": ["package.json"],
            "url": "https://www.schemastore.org/package.json"
        }
    ],
    "Lua.format.defaultConfig": {
        "indent_size": "4",
        "indent_style": "space"
    },
    "Lua.format.enable": true,
    "markdown.preview.fontFamily": "'Google Sans', 'Open Sans', system-ui, sans-serif",
    "material-icon-theme.activeIconPack": "react",
    "material-icon-theme.enableLogging": true,
    "npm.packageManager": "yarn",
    "npm.scriptRunner": "yarn",
    "oneDarkPro.editorTheme": "Shadow",
    "prettier.bracketSameLine": true,
    "prettier.ignorePath": "",
    "prettier.printWidth": 120,
    "prettier.semi": false,
    "prettier.singleAttributePerLine": true,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "prettier.trailingComma": "none",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.enablePytestSupport": false,
    "python.analysis.typeCheckingMode": "strict",
    "scm.inputFontSize": 15,
    "stylelint.lintFiles.glob": "**/*.{css,scss,jsx,tsx}",
    "stylelint.packageManager": "yarn",
    "stylelint.reportDescriptionlessDisables": true,
    "stylelint.reportInvalidScopeDisables": true,
    "stylelint.reportNeedlessDisables": true,
    "stylelint.snippet": [],
    "stylelint.validate": ["css", "sass"],
    "telemetry.telemetryLevel": "off",
    "terminal.external.windowsExec": "wt",
    "terminal.integrated.confirmOnExit": "always",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.env.windows": {},
    "terminal.integrated.fontFamily": "'SpaceMono Nerd Font', 'MesloLGM Nerd Font Mono'",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.fontWeightBold": "normal",
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "args": [],
            "icon": "terminal-cmd",
            "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"]
        },
        "Git Bash": {
            "icon": "terminal-git-bash",
            "source": "Git Bash"
        },
        "PowerShell": {
            "args": [],
            "icon": "terminal-powershell",
            "path": "pwsh.exe"
        }
    },
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.suggest.inlineSuggestion": "alwaysOnTopExceptExactMatch",
    "terminal.integrated.suggest.providers": {
        "lsp": false
    },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.tabs.defaultColor": "terminal.ansiBlack",
    "wgsl.validateOnType": true,
    "window.systemColorTheme": "dark",
    "window.zoomLevel": 1,
    "workbench.browser.searchEngine": "google",
    "workbench.colorCustomizations": {
        "activityBarBadge.background": "#FFA000",
        "breadcrumb.activeSelectionForeground": "#FFA000",
        "editorSuggestWidget.highlightForeground": "#FFA000",
        "editorWidget.border": "#FFA000",
        "editorWidget.resizeBorder": "#FFA000",
        "list.activeSelectionForeground": "#FFA000",
        "list.highlightForeground": "#FFA000",
        "list.inactiveSelectionForeground": "#FFA000",
        "menu.selectionForeground": "#FFA000",
        "menubar.selectionForeground": "#FFA000",
        "notificationLink.foreground": "#FFA000",
        "panelTitle.activeBorder": "#FFA000",
        "pickerGroup.foreground": "#FFA000",
        "progressBar.background": "#FFA000",
        "scrollbarSlider.activeBackground": "#FFA00050",
        "settings.headerForeground": "#FFA000",
        "settings.modifiedItemForeground": "#FFA000",
        "settings.modifiedItemIndicator": "#FFA000",
        "tab.activeBorder": "#FFA000",
        "textLink.foreground": "#FFA000"
    },
    "workbench.experimental.modernUI": true,
    "workbench.externalBrowser": "chrome",
    "workbench.preferredDarkColorTheme": "One Dark Pro Darker",
    "workbench.preferredHighContrastColorTheme": "One Dark Pro Darker",
    "workbench.preferredHighContrastLightColorTheme": "One Dark Pro Darker",
    "workbench.preferredLightColorTheme": "One Dark Pro Night Flat",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.tree.indent": 25,
    "workbench.colorTheme": "One Dark Pro Darker",
    "problems.sortOrder": "position",
    "workbench.editor.revealIfOpen": true,
    "cSpell.useLocallyInstalledCSpellDictionaries": false,
    "eslint.codeActionsOnSave.options": {
        "fixAll": false
    },
    "js/ts.format.indentSwitchCase": false,
    "js/ts.format.insertSpaceAfterCommaDelimiter": false,
    "js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
    "js/ts.format.enabled": false,
    "js/ts.preferences.renameMatchingJsxTags": false,
    "js/ts.preferences.useAliasesForRenames": false,
    "js/ts.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
    "js/ts.format.insertSpaceAfterSemicolonInForStatements": false,
    "js/ts.format.insertSpaceBeforeAndAfterBinaryOperators": false,
    "eslint.codeActionsOnSave.mode": "problems",
    "files.refactoring.autoSave": false,
    "editor.formatOnSave": true
}
