{
    "[html]": {
        "prettier.bracketSameLine": true,
        "prettier.singleAttributePerLine": true
    },
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua"
    },
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false
    },
    "[powershell]": {
        "files.encoding": "utf8bom",
        "editor.defaultFormatter": "ms-vscode.powershell"
    },
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[properties]": {
        "editor.wordWrap": "off"
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[yaml]": {
        "prettier.tabWidth": 2
    },
    "chat.agent.enabled": true,
    "chat.fontSize": 14,
    "chat.mcp.gallery.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "cSpell.autoFormatConfigFile": true,
    "cSpell.customDictionaries": {
        "custom": true,
        "custom-dictionary": {
            "addWords": true,
            "name": "custom-dictionary",
            "path": "~/AppData/Roaming/Code/User/cspell-custom-dictionary.txt",
            "scope": "user"
        }
    },
    "cSpell.ignorePaths": [
        "node_modules",
        "**/node_modules",
        "**/node_modules/**",
        "vscode-extension",
        ".git",
        "*.dll",
        "**/*.dll"
    ],
    "cSpell.ignoreWords": [],
    "cSpell.languageSettings": [
        {
            "dictionaries": ["wordsEn"],
            "languageId": "*",
            "locale": "en"
        },
        {
            "dictionaries": ["wordsEn"],
            "languageId": "*",
            "locale": "en-US"
        },
        {
            "dictionaries": ["wordsEnGb"],
            "languageId": "*",
            "locale": "en-GB"
        },
        {
            "dictionaries": ["companies", "softwareTerms", "misc"],
            "languageId": "*"
        },
        {
            "dictionaries": ["python"],
            "languageId": "python"
        },
        {
            "dictionaries": ["go"],
            "languageId": "go"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "javascript"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "javascriptreact"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "typescript"
        },
        {
            "dictionaries": ["typescript", "node"],
            "languageId": "typescriptreact"
        },
        {
            "dictionaries": ["html", "fonts", "typescript", "css"],
            "languageId": "html"
        },
        {
            "dictionaries": ["php", "html", "fonts", "css", "typescript"],
            "languageId": "php"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "css"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "less"
        },
        {
            "dictionaries": ["fonts", "css"],
            "languageId": "scss"
        }
    ],
    "cSpell.useLocallyInstalledCSpellDictionaries": false,
    "css.validate": false,
    "csv-preview.hasHeaders": false,
    "csv-preview.lineNumbers": "source",
    "csv-preview.resizeColumns": "all",
    "debug.breakpointsView.presentation": "tree",
    "debug.console.fontFamily": "'SpaceMono Nerd Font Propo', 'MesloLGM Nerd Font Mono'",
    "debug.console.historySuggestions": false,
    "debug.openDebug": "openOnDebugBreak",
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.allowVariableFonts": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.shellcheck": "explicit",
        "source.organizeImports": "explicit",
        "source.sortImports": "explicit"
    },
    "editor.codeLensFontSize": 14,
    "editor.colorDecoratorsLimit": 2000,
    "editor.definitionLinkOpensInPeek": true,
    "editor.detectIndentation": false,
    "editor.fontFamily": "'Space Mono', 'Source Code Pro', monospace",
    "editor.fontLigatures": false,
    "editor.glyphMargin": false,
    "editor.indentSize": "tabSize",
    "editor.inlayHints.fontSize": 14,
    "editor.inlineSuggest.edits.renderSideBySide": "never",
    "editor.inlineSuggest.edits.showCollapsed": true,
    "editor.language.brackets": [],
    "editor.renderControlCharacters": true,
    "editor.smoothScrolling": false,
    "editor.tabCompletion": "off",
    "editor.unicodeHighlight.allowedCharacters": {
        "‹": true,
        "›": true
    },
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 80,
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "eslint.bulkSuppression.enable": true,
    "eslint.codeActionsOnSave.mode": "problems",
    "eslint.codeActionsOnSave.options": {
        "fixAll": false,
        "sortOrder": "position"
    },
    "eslint.ignoreUntitled": true,
    "eslint.onIgnoredFiles": "warn",
    "eslint.probe": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "css",
        "scss",
        "sass",
        "html",
        "graphql",
        "json",
        "json5",
        "jsonc",
        "markdown",
        "mdx"
    ],
    "eslint.trace.server": "off",
    "eslint.useESLintClass": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "css",
        "scss",
        "sass",
        "html"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": true,
    "explorer.fileNesting.patterns": {
        ".editorconfig": "eslint.*.ts, stylelint.*.ts, prettier.*.ts",
        "*.db": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.js": "${capture}.d.ts, ${capture}.js.*, ${capture}.css, ${capture}.css.*, ${capture}.min.js",
        "*.jsx": "${capture}.js",
        "*.s3db": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.sqlite": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.ts": "${capture}.d.ts, ${capture}.js, ${capture}.scss, ${capture}.sass, ${capture}.css",
        "*.tsx": "${capture}.ts, ${capture}.d.ts, ${capture}.js, ${capture}.scss, ${capture}.sass, ${capture}.css",
        "package.json": "yarn.lock, .yarnrc.yml, tsconfig.json",
        "README*": "AUTHORS, UNLICENSE",
        "vite.config.ts": "vite.*.ts, index.html, "
    },
    "explorer.incrementalNaming": "smart",
    "explorer.openEditors.minVisible": 15,
    "explorer.openEditors.sortOrder": "alphabetical",
    "explorer.openEditors.visible": 20,
    "explorer.sortOrder": "foldersNestsFiles",
    "explorer.sortOrderLexicographicOptions": "unicode",
    "files.autoSave": "onWindowChange",
    "files.defaultLanguage": "",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.addAICoAuthor": "off",
    "git.autoStash": true,
    "git.blame.ignoreWhitespace": true,
    "git.detectWorktrees": true,
    "git.inputValidation": true,
    "git.showActionButton": {
        "sync": false
    },
    "git.showCommitInput": false,
    "git.showPushSuccessNotification": true,
    "git.terminalGitEditor": true,
    "git.verboseCommit": true,
    "github.copilot.chat.claudeOpus5Prompt.enabled": true,
    "github.copilot.chat.claudeSonnet5Prompt.enabled": true,
    "github.copilot.enable": {
        "*": false
    },
    "html.format.enable": false,
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.wrapLineLength": 80,
    "html.suggest.hideEndTagSuggestions": true,
    "ipynb.experimental.serialization": false,
    "ipynb.pasteImagesAsAttachments.enabled": false,
    "js/ts.format.enabled": false,
    "json.format.enable": false,
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json": true,
        "https://www.schemastore.org/": true
    },
    "json.schemas": [
        {
            "fileMatch": ["package.json"],
            "url": "https://www.schemastore.org/package.json"
        }
    ],
    "less.validate": false,
    "Lua.codeLens.enable": true,
    "Lua.diagnostics.libraryFiles": "Enable",
    "markdown.preview.doubleClickToSwitchToEditor": true,
    "markdown.preview.fontFamily": "'Google Sans', 'Open Sans', system-ui, sans-serif",
    "markdown.validate.enabled": true,
    "notebook.formatOnSave.enabled": true,
    "npm.packageManager": "yarn",
    "npm.scriptRunner": "yarn",
    "oneDarkPro.editorTheme": "One Dark Pro Darker",
    "oneDarkPro.vivid": false,
    "powershell.buttons.showPanelMovementButtons": false,
    "powershell.codeFolding.showLastLine": true,
    "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationAfterEveryPipeline",
    "powershell.codeFormatting.preset": "Stroustrup",
    "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
    "powershell.codeFormatting.useConstantStrings": true,
    "powershell.codeFormatting.useCorrectCasing": true,
    "powershell.integratedConsole.focusConsoleOnExecute": true,
    "powershell.integratedConsole.showOnStartup": false,
    "powershell.sideBar.CommandExplorerVisibility": false,
    "prettier.bracketSameLine": true,
    "prettier.ignorePath": "",
    "prettier.printWidth": 80,
    "prettier.semi": false,
    "prettier.singleAttributePerLine": true,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "prettier.trailingComma": "es5",
    "problems.sortOrder": "position",
    "scm.inputFontSize": 14,
    "scss.validate": false,
    "stylelint.lintFiles.glob": "**/*.{css,scss,jsx,tsx}",
    "stylelint.packageManager": "yarn",
    "stylelint.reportDescriptionlessDisables": true,
    "stylelint.reportInvalidScopeDisables": true,
    "stylelint.reportNeedlessDisables": true,
    "stylelint.snippet": [],
    "stylelint.validate": ["css", "scss", "sass"],
    "telemetry.telemetryLevel": "off",
    "terminal.external.windowsExec": "wt",
    "terminal.integrated.confirmOnExit": "always",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.env.windows": {},
    "terminal.integrated.fontFamily": "'SpaceMono Nerd Font Propo', 'MesloLGM Nerd Font Mono'",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.fontWeightBold": "normal",
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "args": [],
            "icon": "terminal-cmd",
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ]
        },
        "Git Bash": {
            "icon": "terminal-git-bash",
            "source": "Git Bash"
        },
        "PowerShell": {
            "args": [],
            "icon": "terminal-powershell",
            "path": "pwsh.exe"
        }
    },
    "terminal.integrated.rescaleOverlappingGlyphs": false,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.suggest.inlineSuggestion": "alwaysOnTopExceptExactMatch",
    "terminal.integrated.suggest.providers": {
        "lsp": false
    },
    "terminal.integrated.suggest.quickSuggestions": {
        "arguments": "on",
        "commands": "on",
        "unknown": "on"
    },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.tabs.defaultColor": "terminal.ansiBlack",
    "wgsl.validateOnType": true,
    "window.systemColorTheme": "dark",
    "window.zoomLevel": 1,
    "workbench.activityBar.location": "top",
    "workbench.browser.searchEngine": "google",
    "workbench.colorCustomizations": {
        "activityBarBadge.background": "#FFA000",
        "breadcrumb.activeSelectionForeground": "#FFA000",
        "editorSuggestWidget.highlightForeground": "#FFA000",
        "editorWidget.border": "#FFA000",
        "editorWidget.resizeBorder": "#FFA000",
        "list.activeSelectionForeground": "#FFA000",
        "list.highlightForeground": "#FFA000",
        "list.inactiveSelectionForeground": "#FFA000",
        "menu.selectionForeground": "#FFA000",
        "menubar.selectionForeground": "#FFA000",
        "notificationLink.foreground": "#FFA000",
        "panelTitle.activeBorder": "#FFA000",
        "pickerGroup.foreground": "#FFA000",
        "progressBar.background": "#FFA000",
        "scrollbarSlider.activeBackground": "#FFA00050",
        "settings.headerForeground": "#FFA000",
        "settings.modifiedItemForeground": "#FFA000",
        "settings.modifiedItemIndicator": "#FFA000",
        "sideBarSectionHeader.foreground": "#E06C75",
        "tab.activeBorder": "#FFA000",
        "textLink.foreground": "#FFA000"
    },
    "workbench.colorTheme": "One Dark Pro Darker",
    "workbench.editor.decorations.badges": false,
    "workbench.editor.revealIfOpen": true,
    "workbench.editorAssociations": {
        "*.{jpg,jpe,jpeg,png,bmp,gif,ico,webp,avif,svg}": "default",
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.md": "vscode.markdown.editor"
    },
    "workbench.experimental.modernUI": true,
    "workbench.externalBrowser": "chrome",
    "workbench.preferredDarkColorTheme": "One Dark Pro Darker",
    "workbench.preferredHighContrastColorTheme": "One Dark Pro Darker",
    "workbench.preferredHighContrastLightColorTheme": "One Dark Pro Darker",
    "workbench.preferredLightColorTheme": "One Dark Pro Darker",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.tree.indent": 25,
    "eslint.codeAction.disableRuleComment": {
        "enable": false
    },
    "eslint.useRealpaths": true,
    "ruff.lineLength": 80,
    "ruff.importStrategy": "useBundled",
    "editor.formatOnSave": true,
    "Lua.type.inferParamType": true,
    "Lua.type.checkTableShape": true,
    "Lua.runtime.version": "Lua 5.5"
}
