## Source :: https://gitignore.io | https://www.toptal.com/developers/gitignore/
## Create :: https://www.toptal.com/developers/gitignore/api/windows,git,powershell,visualstudiocode,zsh
## Edit   :: https://www.toptal.com/developers/gitignore?templates=windows,git,powershell,visualstudiocode,zsh

#############
#### Git ####
#############

# Created by git for backups. To disable backups in Git:
# $ git config --global mergetool.keepBackup false
*.orig

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt


##################
#### Terminal ####
##################

# Powershell
PowerShell/Modules/*
PowerShell/Scripts/*
!PowerShell/Scripts/Custom
!PowerShell/Modules/Custom

# OMP Themes
.oh-my-posh/*
!.oh-my-posh/themes/otheypsy.omp.json

# OMZ Themes
.oh-my-zsh/*
!.oh-my-zsh/custom/themes/otheypsy.zsh-theme

# Robby Russell OMZ plugin history files
.directory_history

# Zsh Generated Files
.zsh_history
.zsh_sessions
.zcalc_history
._zinit
.zinit_lstupd
zsdoc/data
*.zwc
*.zwc.old
*zcompdump*

# Python Virtual Environment
.venv

# Zunit tests' output
/tests/_output/*
!/tests/_output/.gitkeep


##########################
#### VisualStudioCode ####
##########################

# Core workspace files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local history of files
.history/
.ionide

# Built extensions
*.vsix

# Logs
logs
*.log


#################
#### Windows ####
#################

# Exclude packaged modules
*.zip

# Exclude .NET assemblies from source
*.dll

# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk


#############
#### MPV ####
#############

mpv/cache
mpv/inactive
mpv/playlists
mpv/screenshots
!mpv/scripts/display-info.dll
*.m3u
*.m3u8
*.mp4
*.mpv
*.jpeg
*.jpg

# End of https://www.toptal.com/developers/gitignore/api/windows,git,powershell,visualstudiocode,zsh
