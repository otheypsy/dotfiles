{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "final_space": true,
    "cursor_style": "default_blinking",
    "upgrade": {
        "notice": true,
        "interval": "168h",
        "auto": false,
        "source": "github"
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "type": "path",
                    "style": "powerline",
                    "foreground": "#6EDFF6",
                    "options": {
                        "style": "full"
                    },
                    "template": "{{ .Path }} "
                },
                {
                    "type": "git",
                    "style": "powerline",
                    "foreground": "#FFDA6A",
                    "template": "\u276f {{ .HEAD }} "
                },
                {
                    "type": "text",
                    "style": "powerline",
                    "foreground": "#75B798",
                    "template": "\u276f\u276f"
                }
            ]
        },
        {
            "type": "rprompt",
            "alignment": "right",
            "segments": [
                {
                    "foreground": "#75B798",
                    "options": {
                        "time_format": "15:04:05"
                    },
                    "style": "plain",
                    "template": "{{ .CurrentDate | date .Format }} ",
                    "type": "time"
                }
            ]
        }
    ],
    "version": 4
}
