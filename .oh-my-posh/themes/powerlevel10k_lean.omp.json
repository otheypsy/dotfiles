{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "upgrade": {
        "notice": true,
        "interval": "168h",
        "auto": false,
        "source": "cdn"
    },
    "profiles": {
        "defaults": {
            "font": {
                "face": "SpaceMono Nerd Font"
            }
        }
    },
    "console_title_template": "{{.Folder}}{{if .Root}} :: root{{end}} :: {{.Shell}}",
    "blocks": [
        {
            "segments": [
                {
                    "foreground": "#00C5C7",
                    "options": {
                        "time_format": "15:04:05"
                    },
                    "style": "plain",
                    "template": " {{ .CurrentDate | date .Format }} ",
                    "type": "time"
                }
            ],
            "type": "rprompt"
        },
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "#77E4F7",
                    "options": {
                        "style": "full"
                    },
                    "style": "plain",
                    "template": "{{ .Path }} ",
                    "type": "path"
                },
                {
                    "foreground": "#FFE700",
                    "style": "plain",
                    "template": "{{ .HEAD }} ",
                    "type": "git"
                },
                {
                    "foreground": "#43D426",
                    "style": "plain",
                    "template": "\u276f ",
                    "type": "text"
                }
            ],
            "type": "prompt"
        }
    ],
    "version": 4
}
