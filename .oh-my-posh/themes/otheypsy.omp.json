{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "final_space": false,
    "cursor_style": "default_blinking",
    "upgrade": {
        "notice": true,
        "interval": "48h",
        "auto": false,
        "source": "cdn"
    },
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "type": "status",
                    "style": "diamond",
                    "foreground": "#75b798",
                    "options": {
                        "always_enabled": true
                    },
                    "template": "{{ if eq .Code 0 }}\n  [ \uf00c  Success ]\n{{ end }}"
                },
                {
                    "type": "status",
                    "style": "diamond",
                    "foreground": "#ea868f",
                    "options": {
                        "always_enabled": true
                    },
                    "template": "{{ if ne .Code 0 }}\n  [ \uf071  {{ reason .Code }} ]\n{{ end }}"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "#ffDa6a",
                    "template": "\u256d\u2500\u007c "
                },
                {
                    "type": "time",
                    "style": "diamond",
                    "foreground": "#ffDa6a",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "time_format": "15:04:05"
                    },
                    "template": "{{ .CurrentDate | date .Format }}"
                },
                {
                    "type": "path",
                    "style": "diamond",
                    "foreground": "#3EC669",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "style": "full"
                    },
                    "template": "\ue5ff {{ .Path }}"
                },
                {
                    "type": "git",
                    "style": "diamond",
                    "foreground": "#43CCEA",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "branch_template": "{{ trunc 25 .Branch }}",
                        "fetch_status": true,
                        "fetch_upstream_icon": true
                    },
                    "foreground_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
                        "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
                        "{{ if gt .Behind 0 }}#B388FF{{ end }}"
                    ],
                    "template": "{{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}"
                },
                {
                    "type": "node",
                    "style": "diamond",
                    "foreground": "#88e570",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "display_mode": "files",
                        "fetch_version": true
                    },
                    "template": "\ue718 {{ .Full }}]"
                },
                {
                    "type": "node",
                    "style": "diamond",
                    "foreground": "#37aee5",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "display_mode": "files",
                        "fetch_package_manager": true
                    },
                    "template": "{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }}{{ end }} {{ .PackageManagerName }}"
                },
                {
                    "type": "python",
                    "style": "diamond",
                    "foreground": "#FED142",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "display_mode": "context",
                        "fetch_virtual_env": false
                    },
                    "template": "{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
                },
                {
                    "type": "upgrade",
                    "style": "diamond",
                    "foreground": "#FFD664",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "cache_duration": "168h"
                    },
                    "template": "{{ if ne .Current .Latest }}\uf019 oh-my-posh {{ .Latest }}{{ end }}"
                },
                {
                    "type": "winget",
                    "style": "diamond",
                    "foreground": "#FFD664",
                    "trailing_diamond": "  \u276f\u276f  ",
                    "options": {
                        "cache_duration": "168h"
                    },
                    "cache": {
                        "duration": "24h",
                        "strategy": "device"
                    },
                    "template": "\uf409 winget {{ .UpdateCount }}"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "foreground": "#ffDa6a",
                    "style": "plain",
                    "template": "\u2570\u2500{{ if .Root }}\u276f{{else}}\u276f{{end}} ",
                    "type": "text"
                }
            ],
            "type": "prompt"
        }
    ],
    "version": 4
}
