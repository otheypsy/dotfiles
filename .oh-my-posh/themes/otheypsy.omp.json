{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "final_space": false,
    "cursor_style": "default_blinking",
    "upgrade": {
        "notice": true,
        "interval": "48h",
        "auto": false,
        "source": "cdn"
    },
    "console_title_template": "{{ if .Segments.Project }} {{ .Segments.Project.Name }} {{ else }} {{.Folder}} {{ end }}",
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "type": "status",
                    "style": "diamond",
                    "foreground": "#75b798",
                    "options": {
                        "always_enabled": true
                    },
                    "template": "{{ if and (.Executed) (eq .Code 0) }}\n  \u29fc\u29fc Success \u29fd\u29fd \n{{ end }}"
                },
                {
                    "type": "status",
                    "style": "diamond",
                    "foreground": "#ea868f",
                    "options": {
                        "always_enabled": true
                    },
                    "template": "{{ if and (.Executed) (ne .Code 0) }}\n  \u29fc\u29fc {{ reason .Code }} \u29fd\u29fd \n{{ end }}"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "type": "prompt",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "template": "{{ if .Root }}<#ea868f>{{else}}<#906cff>{{end}}\u256d\u2500\uf192  </>"
                },
                {
                    "type": "path",
                    "style": "diamond",
                    "foreground": "#3ec669",
                    "options": {
                        "style": "full"
                    },
                    "template": "\ue5ff  {{ .Path }}"
                },
                {
                    "type": "project",
                    "style": "diamond",
                    "foreground": "#ffda6a",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "style": "full"
                    },
                    "template": "{{ if .Name }}\uf135  {{ .Name }}{{ end }}"
                },
                {
                    "type": "winget",
                    "style": "diamond",
                    "foreground": "#da627d",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "cache_duration": "24h"
                    },
                    "cache": {
                        "duration": "24h",
                        "strategy": "device"
                    },
                    "template": "\uf409  winget {{ .UpdateCount }}"
                }
            ]
        },
        {
            "alignment": "left",
            "type": "prompt",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "template": "{{ if .Root }}<#ea868f>{{else}}<#906cff>{{end}}\u2502</>    "
                },
                {
                    "type": "time",
                    "style": "diamond",
                    "foreground": "#6edff6",
                    "options": {
                        "time_format": "15:04:05"
                    },
                    "template": "\udb82\udd54  {{ .CurrentDate | date .Format }}"
                },
                {
                    "type": "git",
                    "style": "diamond",
                    "foreground": "#75b798",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "branch_template": "{{ trunc 25 .Branch }}",
                        "fetch_status": true,
                        "fetch_upstream_icon": true
                    },
                    "foreground_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff9248{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#da627d{{ end }}",
                        "{{ if gt .Ahead 0 }}#da627d{{ end }}",
                        "{{ if gt .Behind 0 }}#da627d{{ end }}"
                    ],
                    "template": "{{ .UpstreamIcon }}  {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}"
                },
                {
                    "type": "node",
                    "style": "diamond",
                    "foreground": "#75b798",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "display_mode": "files",
                        "fetch_version": true
                    },
                    "template": "\ue718  {{ .Full }}"
                },
                {
                    "type": "yarn",
                    "style": "diamond",
                    "foreground": "#6ea8fe",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "template": "\ue6a7  {{.Full}}"
                },
                {
                    "type": "react",
                    "style": "diamond",
                    "foreground": "#ff9248",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "display_mode": "files",
                        "fetch_package_manager": true
                    },
                    "template": "{{ if not .Error }}{{ else }}\udb81\udf08  {{ .Full }}{{ end }}"
                },
                {
                    "type": "python",
                    "style": "diamond",
                    "foreground": "#6ea8fe",
                    "leading_diamond": "<#906cff>  \uf142  </>",
                    "options": {
                        "display_mode": "context",
                        "fetch_virtual_env": false
                    },
                    "template": "{{ if .Error }}{{ .Error }}{{ else }}\ue73c  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}"
                }
            ]
        },
        {
            "type": "prompt",
            "newline": true,
            "alignment": "left",
            "segments": [
                {
                    "style": "plain",
                    "template": "{{ if .Root }}<#ea868f>{{else}}<#906cff>{{end}}\u2570\u2500\u2771</>  ",
                    "type": "text"
                }
            ]
        }
    ],
    "valid_line": {
        "style": "plain",
        "template": "<#3ec669>\u2771 </>"
    },
    "error_line": {
        "style": "plain",
        "template": "<#ea868f>\u2771 </>"
    },
    "version": 4
}
